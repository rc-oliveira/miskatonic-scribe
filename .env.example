# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of authorized Telegram numeric user IDs
TELEGRAM_ALLOWED_USER_IDS=1725371455
# Timeouts and retry policy for downloading voice/audio files from Telegram
TELEGRAM_CONNECT_TIMEOUT=30.0
TELEGRAM_READ_TIMEOUT=60.0
TELEGRAM_DOWNLOAD_RETRIES=3

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model Configuration
GEMINI_MODEL=gemini-3.5-flash

# Fallback models in case primary model hits rate-limits or high demand (503/429)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-latest
GEMINI_MAX_RETRIES=2
GEMINI_INITIAL_DELAY=1.0

# Whisper Configuration
WHISPER_MODEL_NAME=base
WHISPER_DEVICE=cpu

# Audio Storage & Maintenance Configuration
AUDIO_STORAGE_DIR=temp_audio
AUDIO_MAX_FILES=5
AUDIO_MAX_AGE_DAYS=3

# ArkhamDB & Persistence Configuration
ARKHAMDB_CARDS_PATH=cards.json
ARKHAMDB_API_URL=https://arkhamdb.com/api/public/cards/
ARKHAMDB_REFRESH_DAYS=30
FUZZY_MATCH_THRESHOLD=65
USER_COLLECTION_DB_PATH=data/user_collections.json

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=data/logs/miskatonic_scribe.log
